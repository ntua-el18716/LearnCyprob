---
import BlogLayout from "@layouts/BlogLayout.astro";
import DocumentLayout from "@layouts/DocumentLayout.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("document");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"document">;

const post = Astro.props;
const frontmatter = post.data;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<DocumentLayout
  title={frontmatter.title}
  pubDate={frontmatter.pubDate}
  image={frontmatter.hero}
  imageAlt={frontmatter.heroAlt}
  description={frontmatter.description}
  url={post.id}
  updatedDate={frontmatter.updatedDate}
  readingTime={remarkPluginFrontmatter.minutesRead}
  numOfImages={frontmatter.numOfImages}
  documentImages={frontmatter.documentImages}
>
  <Content />
</DocumentLayout>
