---
import Layout from "@layouts/Layout.astro";
import PageNotice from "@components/PageNotice.astro";
import ScanGallery from "@components/ScanGallery.astro";
import { getEntries, render } from "astro:content";
import { publishedLocales, type Locale } from "../../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../../lib/i18n";
import {
  formatDocumentDate,
  getCitingIssues,
  getDocuments,
  getDocumentText,
} from "../../../../lib/documents";

export async function getStaticPaths() {
  const documents = await getDocuments();
  return publishedLocales.flatMap((lang) =>
    documents.map((doc) => ({ params: { lang, slug: doc.id }, props: { doc } })),
  );
}

const { doc } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { data } = doc;

const title = pickLocalized(data.title, lang);
const provenance = data.provenance && pickLocalized(data.provenance, lang);
const parties = await getEntries(data.parties);
const text = await getDocumentText(doc.id, lang);
const Text = text ? (await render(text.entry)).Content : undefined;
const citedIn = await getCitingIssues(doc.id, lang);

const typeKey = data.type && (`documents.type.${data.type}` as const);
const hasProvenance =
  provenance || data.isLeaked || data.officialUrl || data.archiveUrl || data.copyrightNote;
const langAttr = (r: { isFallback: boolean; lang: string }) => (r.isFallback ? r.lang : undefined);
const alternates = Object.fromEntries(
  publishedLocales.map((l) => [l, localizePath(l, `documents/${doc.id}`)]),
);
const linkClass = "underline decoration-zinc-400 underline-offset-2";
---

<Layout
  lang={lang}
  title={title.text}
  alternates={alternates}
  noindex={data.draft}
>
  {data.draft && <PageNotice kind="draft">{t("draft.banner")}</PageNotice>}

  <article>
    <header class="mb-8">
      <h1
        lang={langAttr(title)}
        class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-100"
      >
        {title.text}
      </h1>
      {data.originalTitle && <p class="mt-2 text-lg text-zinc-700 dark:text-zinc-300">{data.originalTitle}</p>}

      <dl class="mt-6 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[minmax(7rem,auto)_1fr]">
        <dt class="font-semibold text-zinc-600 dark:text-zinc-400">{t("documents.date")}</dt>
        <dd>
          <time datetime={data.date.toISOString().slice(0, 10)}>
            {formatDocumentDate(data.date, data.dateCertainty, lang, t)}
          </time>
        </dd>
        {
          typeKey && (
            <>
              <dt class="font-semibold text-zinc-600 dark:text-zinc-400">{t("documents.type")}</dt>
              <dd lang={t.langOf(typeKey)}>{t(typeKey)}</dd>
            </>
          )
        }
        {
          parties.length > 0 && (
            <>
              <dt class="font-semibold text-zinc-600 dark:text-zinc-400">{t("documents.parties")}</dt>
              <dd>
                {parties.map((actor, i) => {
                  const name = pickLocalized(actor.data.name, lang);
                  // One line: whitespace here would put a space before the comma.
                  return (<>{i > 0 && ", "}<span lang={langAttr(name)}>{name.text}</span></>);
                })}
              </dd>
            </>
          )
        }
        {
          hasProvenance && (
            <>
              <dt class="font-semibold text-zinc-600 dark:text-zinc-400">{t("documents.provenance")}</dt>
              <dd lang={provenance ? langAttr(provenance) : undefined}>
                {data.isLeaked && (
                  <strong class="mr-1" lang={t.langOf("documents.leaked")}>{t("documents.leaked")}.</strong>
                )}
                {provenance?.text}
                {data.officialUrl && (
                  <> <a href={data.officialUrl} class={linkClass}>{t("documents.officialCopy")}</a>.</>
                )}
                {data.archiveUrl && (
                  <> <a href={data.archiveUrl} class={linkClass}>{t("sources.archived")}</a>.</>
                )}
                {data.copyrightNote && <span class="block mt-1">{data.copyrightNote}</span>}
              </dd>
            </>
          )
        }
        {
          data.files.length > 0 && (
            <>
              <dt class="font-semibold text-zinc-600 dark:text-zinc-400">{t("documents.files")}</dt>
              <dd>
                <ul>
                  {data.files.map((file) => {
                    const kindKey = `documents.file.${file.kind}` as const;
                    return (
                      <li>
                        <a
                          href={file.path}
                          hreflang={file.lang}
                          download={file.path.endsWith(".pdf") ? "" : undefined}
                          class={linkClass}
                        >
                          {t(kindKey)} ({file.lang})
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </dd>
            </>
          )
        }
      </dl>
    </header>

    <ScanGallery scans={data.scans} />

    <section aria-labelledby="text" class="mt-10">
      <h2 id="text" class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">
        {t("documents.text")}
      </h2>
      {text?.isFallback && <PageNotice kind="translation">{t("translation.missing")}</PageNotice>}
      {
        Text ? (
          <div
            lang={text?.isFallback ? text.lang : undefined}
            class="document-text prose prose-zinc dark:prose-invert max-w-none mt-4 font-serif"
          >
            <Text />
          </div>
        ) : (
          <p class="mt-4 text-zinc-600 dark:text-zinc-400">{t("documents.noText")}</p>
        )
      }
    </section>

    {
      citedIn.length > 0 && (
        <nav aria-labelledby="cited-in" class="mt-12">
          <h2 id="cited-in" class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">
            {t("documents.citedIn")}
          </h2>
          <ul class="mt-3 list-disc pl-5">
            {citedIn.map((issue) => (
              <li lang={langAttr(issue)}>
                <a href={localizePath(lang, `issues/${issue.entry.data.slug}`)} class={linkClass}>
                  {issue.entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Layout>

<style>
  /* Cited paragraphs are deep-link targets (#para-12); show which one. */
  .document-text :global(:target) {
    @apply bg-zinc-200/70 dark:bg-zinc-800/70 rounded-sm;
    scroll-margin-top: 2rem;
  }
</style>
