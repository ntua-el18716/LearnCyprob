---
import Layout from "@layouts/Layout.astro";
import PageNotice from "@components/PageNotice.astro";
import ScanGallery from "@components/ScanGallery.astro";
import { Icon } from "astro-icon/components";
import { getEntries, render } from "astro:content";
import { publishedLocales, type Locale } from "../../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../../lib/i18n";
import {
  formatDocumentDate,
  getCitingIssues,
  getDocuments,
  getDocumentText,
} from "../../../../lib/documents";

export async function getStaticPaths() {
  const documents = await getDocuments();
  return publishedLocales.flatMap((lang) =>
    documents.map((doc) => ({ params: { lang, slug: doc.id }, props: { doc } })),
  );
}

const { doc } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { data } = doc;

const title = pickLocalized(data.title, lang);
const provenance = data.provenance && pickLocalized(data.provenance, lang);
const parties = await getEntries(data.parties);
const text = await getDocumentText(doc.id, lang);
const Text = text ? (await render(text.entry)).Content : undefined;
const citedIn = await getCitingIssues(doc.id, lang);

const typeKey = data.type && (`documents.type.${data.type}` as const);
const hasProvenance =
  provenance || data.isLeaked || data.officialUrl || data.archiveUrl || data.copyrightNote;
const langAttr = (r: { isFallback: boolean; lang: string }) => (r.isFallback ? r.lang : undefined);
const alternates = Object.fromEntries(
  publishedLocales.map((l) => [l, localizePath(l, `documents/${doc.id}`)]),
);
const linkClass = "link";
// Fact grid cells.
const cell = "bg-bg p-4";
const term = "text-sm font-semibold text-muted";
const value = "mt-1 text-lg font-semibold";
---

<Layout
  lang={lang}
  title={title.text}
  alternates={alternates}
  noindex={data.draft}
>
  <article>
    <header class="page-band">
      {data.draft && <PageNotice kind="draft">{t("draft.banner")}</PageNotice>}
      <p class="mb-4 text-sm font-semibold">
        <a href={localizePath(lang, "documents")} class="inline-flex items-center gap-1.5 link"><Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />{t("documents.title")}</a>
      </p>
      <h1
        lang={langAttr(title)}
        class="page-title max-w-4xl"
      >
        {title.text}
      </h1>
      {data.originalTitle && <p class="mt-2 text-lg text-ink">{data.originalTitle}</p>}

      <!-- Facts as a grid of cells; 1px gaps over a rule-coloured background draw the dividers. -->
      <dl class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule shadow-sm sm:grid-cols-[repeat(auto-fit,minmax(13rem,1fr))]">
        <div class={cell}>
          <dt class={term}>{t("documents.date")}</dt>
          <dd class={value}>
            <time datetime={data.date.toISOString().slice(0, 10)}>{formatDocumentDate(data.date, data.dateCertainty, lang, t)}</time>
          </dd>
        </div>
        {
          typeKey && (
            <div class={cell}>
              <dt class={term}>{t("documents.type")}</dt>
              <dd class={value} lang={t.langOf(typeKey)}>{t(typeKey)}</dd>
            </div>
          )
        }
        {
          parties.length > 0 && (
            <div class={cell}>
              <dt class={term}>{t("documents.parties")}</dt>
              <dd class={value}>
                {parties.map((actor, i) => {
                  const name = pickLocalized(actor.data.name, lang);
                  // One line: whitespace here would put a space before the comma.
                  return (<>{i > 0 && ", "}<span lang={langAttr(name)}>{name.text}</span></>);
                })}
              </dd>
            </div>
          )
        }
        {
          hasProvenance && (
            <div class:list={[cell, "col-span-full"]}>
              <dt class={term}>{t("documents.provenance")}</dt>
              <dd class="mt-1" lang={provenance ? langAttr(provenance) : undefined}>
                {data.isLeaked && (
                  <strong class="mr-2 inline-block rounded-full bg-sunken px-2.5 py-0.5 text-sm" lang={t.langOf("documents.leaked")}>{t("documents.leaked")}</strong>
                )}
                {provenance?.text}
                {data.officialUrl && (
                  <> <a href={data.officialUrl} class={linkClass}>{t("documents.officialCopy")}</a>.</>
                )}
                {data.archiveUrl && (
                  <> <a href={data.archiveUrl} class={linkClass}>{t("sources.archived")}</a>.</>
                )}
                {data.copyrightNote && <span class="mt-1 block text-sm text-muted">{data.copyrightNote}</span>}
              </dd>
            </div>
          )
        }
      </dl>
      {
        data.files.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-3" aria-label={t("documents.files")}>
            {data.files.map((file) => {
              const kindKey = `documents.file.${file.kind}` as const;
              return (
                <li>
                  <a
                    href={file.path}
                    hreflang={file.lang}
                    download={file.path.endsWith(".pdf") ? "" : undefined}
                    class="btn px-5 py-2.5"
                  >
                    <Icon name="lucide:download" class="size-5" aria-hidden="true" />
                    {t(kindKey)} ({file.lang.toUpperCase()}{file.path.endsWith(".pdf") ? ", PDF" : ""})
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </header>

    <ScanGallery scans={data.scans} />

    <section aria-labelledby="text" class="mt-12 max-w-[46rem]">
      <h2 id="text" class="text-2xl font-[720]">
        {t("documents.text")}
      </h2>
      {text?.isFallback && <PageNotice kind="translation">{t("translation.missing")}</PageNotice>}
      {
        Text ? (
          <div
            lang={text?.isFallback ? text.lang : undefined}
            class="document-text prose prose-site max-w-none mt-4"
          >
            <Text />
          </div>
        ) : (
          <p class="mt-4 text-muted">{t("documents.noText")}</p>
        )
      }
    </section>

    {
      citedIn.length > 0 && (
        <nav aria-labelledby="cited-in" class="mt-12">
          <h2 id="cited-in" class="text-2xl font-[720]">
            {t("documents.citedIn")}
          </h2>
          <ul class="mt-4 divide-y divide-rule border-y border-rule">
            {citedIn.map((issue) => (
              <li class="py-3" lang={langAttr(issue)}>
                <a href={localizePath(lang, `issues/${issue.entry.data.slug}`)} class="font-semibold link">
                  {issue.entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Layout>

<style>
  /* Cited paragraphs are deep-link targets (#para-12); show which one. */
  .document-text :global(:target) {
    @apply bg-panel rounded-sm;
    scroll-margin-top: 2rem;
  }
</style>
