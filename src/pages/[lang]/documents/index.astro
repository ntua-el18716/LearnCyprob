---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../lib/i18n";
import { formatDocumentDate, getDocuments } from "../../../lib/documents";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const documents = await getDocuments();
const alternates = Object.fromEntries(
  publishedLocales.map((l) => [l, localizePath(l, "documents")]),
);
---

<Layout
  lang={lang}
  title={t("documents.title")}
  description={t("documents.description")}
  alternates={alternates}
>
  <PageHeader title={t("documents.title")} intro={t("documents.description")} introLang={t.langOf("documents.description")} />
  <div class="max-w-3xl">
  <ul class="divide-y divide-rule">
    {
      documents.map((doc) => {
        const title = pickLocalized(doc.data.title, lang);
        const typeKey = doc.data.type && (`documents.type.${doc.data.type}` as const);
        return (
          <li class="py-4">
            <a
              href={localizePath(lang, `documents/${doc.id}`)}
              lang={title.isFallback ? title.lang : undefined}
              class="font-semibold text-ink link"
            >
              {title.text}
            </a>
            <p class="mt-1 flex flex-wrap gap-x-4 text-sm text-muted">
              <time datetime={doc.data.date.toISOString().slice(0, 10)}>
                {formatDocumentDate(doc.data.date, doc.data.dateCertainty, lang, t)}
              </time>
              {typeKey && <span lang={t.langOf(typeKey)}>{t(typeKey)}</span>}
              {doc.data.draft && <span>{t("draft.label")}</span>}
            </p>
          </li>
        );
      })
    }
  </ul>
  </div>
</Layout>
