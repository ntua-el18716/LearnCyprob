---
import Layout from "@layouts/Layout.astro";
import { publishedLocales, type Locale } from "../../i18n/locales";
import { localizePath, useTranslations } from "../../lib/i18n";
import { getIssue, getIssueSlugs } from "../../lib/issues";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// Most recently reviewed issues, in this language where available.
const recent = (await Promise.all((await getIssueSlugs()).map((s) => getIssue(s, lang))))
  .filter((r) => r !== undefined)
  .sort(
    (a, b) =>
      b.entry.data.lastReviewed.valueOf() - a.entry.data.lastReviewed.valueOf() ||
      a.entry.data.slug.localeCompare(b.entry.data.slug),
  )
  .slice(0, 3);

// Entry points: the author's four "why use" lines, each leading to its section.
const entries = [
  { key: "home.benefit.aspects", href: localizePath(lang, "explore") },
  { key: "home.benefit.history", href: localizePath(lang, "timeline") },
  { key: "home.benefit.documents", href: localizePath(lang, "documents") },
  { key: "home.benefit.latest", href: localizePath(lang, "timeline") },
] as const;
---

<Layout lang={lang}>
  <section class="max-w-3xl">
    <h1 class="text-5xl sm:text-6xl font-[780] tracking-[-0.025em] leading-[1.02]" lang={t.langOf("home.title")}>
      {t("home.title")}
    </h1>
    <p class="mt-5 text-xl sm:text-2xl leading-snug text-muted" lang={t.langOf("home.intro")}>
      {t("home.intro")}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localizePath(lang, "explore")} class="rounded-md bg-accent px-5 py-3 font-semibold text-on-accent hover:bg-accent/90">
        {t("explore.title")}
      </a>
      <a href={localizePath(lang, "documents")} class="rounded-md border-2 border-ink px-5 py-3 font-semibold hover:bg-sunken">
        {t("documents.title")}
      </a>
    </div>
  </section>

  <section class="mt-16 sm:mt-20" aria-labelledby="why">
    <h2 id="why" class="text-2xl font-[720]" lang={t.langOf("home.why")}>{t("home.why")}</h2>
    <ul class="mt-6 grid gap-x-10 gap-y-2 sm:grid-cols-2">
      {
        entries.map((e) => (
          <li class="border-t-2 border-accent">
            <a href={e.href} class="block py-4 text-lg font-semibold leading-snug hover:underline hover:underline-offset-4" lang={t.langOf(e.key)}>
              {t(e.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 sm:mt-20" aria-labelledby="recent">
    <h2 id="recent" class="text-2xl font-[720]" lang={t.langOf("home.recent")}>{t("home.recent")}</h2>
    <ul class="mt-4 divide-y divide-rule border-y border-rule">
      {
        recent.map(({ entry, lang: entryLang, isFallback }) => (
          <li class="py-4" lang={isFallback ? entryLang : undefined}>
            <a href={localizePath(lang, `issues/${entry.data.slug}`)} class="text-lg font-semibold link">
              {entry.data.title}
            </a>
            <p class="mt-1 text-muted">{entry.data.summary}</p>
          </li>
        ))
      }
    </ul>
    <a href={localizePath(lang, "issues")} class="mt-5 inline-block font-semibold link" lang={t.langOf("home.viewAll")}>
      {t("home.viewAll")}
    </a>
  </section>
</Layout>
