---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Benefit from "@components/Benefit.astro";
import { publishedLocales, type Locale } from "../../i18n/locales";
import { localizePath, useTranslations } from "../../lib/i18n";
import { getIssue, getIssueSlugs } from "../../lib/issues";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// Most recently reviewed issues, in this language where available.
const recent = (await Promise.all((await getIssueSlugs()).map((s) => getIssue(s, lang))))
  .filter((r) => r !== undefined)
  .sort(
    (a, b) =>
      b.entry.data.lastReviewed.valueOf() - a.entry.data.lastReviewed.valueOf() ||
      a.entry.data.slug.localeCompare(b.entry.data.slug),
  )
  .slice(0, 3);
---

<Layout lang={lang}>
  <section class="text-center">
    <div class="grid place-items-center">
      <Header title={t("home.title")} lang={t.langOf("home.title")} />
      <p
        class="mt-3 max-w-prose leading-relaxed"
        lang={t.langOf("home.intro")}
      >
        {t("home.intro")}
      </p>
    </div>
  </section>
  <section class="text-center mt-20">
    <div>
      <Header title={t("home.why")} lang={t.langOf("home.why")} />
      <ul class="grid grid-cols-1 gap-4 place-items-center">
        <Benefit
          iconName="peace-cooperate-together"
          title={t("home.benefit.aspects")}
          lang={t.langOf("home.benefit.aspects")}
        />
        <Benefit
          iconName="peace-negotiations"
          title={t("home.benefit.history")}
          lang={t.langOf("home.benefit.history")}
        />
        <Benefit
          iconName="peace-document"
          title={t("home.benefit.documents")}
          lang={t.langOf("home.benefit.documents")}
        />
        <Benefit
          iconName="peace-calendar"
          title={t("home.benefit.latest")}
          lang={t.langOf("home.benefit.latest")}
        />
      </ul>
    </div>
  </section>
  <section>
    <h2
      class="mt-12 text-2xl font-semibold dark:text-zinc-100 text-zinc-900"
      lang={t.langOf("home.recent")}
    >
      {t("home.recent")}
    </h2>
    <ul class="mt-6 divide-y divide-zinc-300 dark:divide-zinc-700">
      {
        recent.map(({ entry, lang: entryLang, isFallback }) => (
          <li class="py-4" lang={isFallback ? entryLang : undefined}>
            <a
              href={localizePath(lang, `issues/${entry.data.slug}`)}
              class="font-semibold text-zinc-900 dark:text-zinc-100 underline decoration-zinc-400 underline-offset-2"
            >
              {entry.data.title}
            </a>
            <p class="mt-1 text-sm">{entry.data.summary}</p>
          </li>
        ))
      }
    </ul>
    <a
      class="inline-block mt-7 dark:hover:text-zinc-50 hover:text-zinc-400 transition-colors"
      href={localizePath(lang, "issues")}
      lang={t.langOf("home.viewAll")}>{t("home.viewAll")} &rarr;</a
    >
  </section>
</Layout>
