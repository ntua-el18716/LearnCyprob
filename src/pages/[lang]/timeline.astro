---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import SourceLinks from "@components/SourceLinks.astro";
import ChapterIcon from "@components/ChapterIcon.astro";
import TimelineOverview from "@components/TimelineOverview.astro";
import { eras as allEras, type Era } from "../../lib/eras";
import { getCollection, getEntries } from "astro:content";
import { publishedLocales, type Locale } from "../../i18n/locales";
import { isVisible } from "../../lib/drafts";
import { formatDocumentDate } from "../../lib/documents";
import { localizePath, pickLocalized, useTranslations } from "../../lib/i18n";
import { getIssue, getIssueTree } from "../../lib/issues";
import { chapterOf } from "../../lib/chapters";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const events = (await getCollection("events", isVisible)).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
);

// Eras in schema order; label "1960-1963" as "1960–1963", and the open ends
// in words.
const eraLabel = (era: Era) => {
  const [from, to] = era.split("-");
  if (from === "pre") return t("era.before", { year: to });
  if (to === "present") return t("era.since", { year: from });
  return `${from}–${to}`;
};
// Eras that have events, in era order.
const eras = allEras.filter((era) => events.some((e) => e.data.era === era));

const enriched = await Promise.all(
  events.map(async (event) => ({
    event,
    title: pickLocalized(event.data.title, lang),
    summary: pickLocalized(event.data.summary, lang),
    issues: (await Promise.all(event.data.issues.map((s) => getIssue(s, lang)))).filter((i) => i !== undefined),
    documents: await getEntries(event.data.documents),
  })),
);
// Each event shows the chapter of its first linked issue, and is filtered by
// the chapters of all of them.
const tree = await getIssueTree(lang);
const chapters = chapterOf(tree);
const chaptersOf = (issues: (typeof enriched)[number]["issues"]) => [
  ...new Set(issues.map((i) => chapters.get(i.entry.data.slug)).filter((c) => c !== undefined)),
];
const usedChapters = new Set(enriched.flatMap(({ issues }) => chaptersOf(issues)));
const chapterFilters = tree.filter((c) => usedChapters.has(c.slug));
const chipBase = "rounded-full border border-rule px-3.5 py-1.5 text-sm font-semibold transition hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent";
const formatDate = (d: Date, c: (typeof events)[number]["data"]["dateCertainty"]) =>
  formatDocumentDate(d, c, lang, t);
const alternates = Object.fromEntries(publishedLocales.map((l) => [l, localizePath(l, "timeline")]));
---

<Layout lang={lang} title={t("timeline.title")} description={t("timeline.description")} alternates={alternates}>
  <PageHeader icon="lucide:milestone" title={t("timeline.title")} intro={t("timeline.description")} introLang={t.langOf("timeline.description")} />
  {events.length === 0 && <p>{t("timeline.empty")}</p>}
  {
    events.length > 0 && (
      <TimelineOverview
        label={t("timeline.overview")}
        eraLabel={eraLabel}
        events={enriched.map(({ event, title }) => ({
          id: event.id,
          date: event.data.date,
          importance: event.data.importance,
          title: title.text,
          lang: title.isFallback ? title.lang : undefined,
          era: event.data.era,
        }))}
      />
    )
  }

  <!-- `hidden` on a wrapper without a display class; filters need JavaScript. -->
  {
    events.length > 0 && (
      <div data-tl-controls data-shown={t("timeline.shown")} hidden>
        <div class="mb-10 space-y-4 rounded-2xl border border-rule p-4 sm:p-5">
          <div class="flex flex-wrap items-end gap-x-6 gap-y-4">
            <label class="block w-full max-w-xs text-sm font-semibold">
              {t("timeline.search")}
              <input type="search" data-tl-search class="control mt-1 w-full font-normal" />
            </label>
            <label class="flex items-center gap-2 pb-2 text-sm font-semibold">
              <input type="checkbox" data-tl-major class="size-4 accent-[rgb(var(--accent))]" />
              {t("timeline.majorOnly")}
            </label>
          </div>
          {chapterFilters.length > 0 && (
            <div role="group" aria-label={t("timeline.filterChapter")} class="flex flex-wrap gap-2">
              <button type="button" data-tl-chapter="" aria-pressed="true" class={chipBase}>{t("timeline.allChapters")}</button>
              {chapterFilters.map((c) => (
                <button type="button" data-tl-chapter={c.slug} aria-pressed="false" class={chipBase} lang={c.isFallback ? c.lang : undefined}>{c.title}</button>
              ))}
            </div>
          )}
          <p role="status" class="text-sm text-muted" data-tl-status></p>
        </div>
      </div>
    )
  }

  <p data-tl-empty hidden class="rounded-2xl border border-rule p-6">{t("timeline.noMatches")}</p>

  <div class="relative" data-tl-body>
    <!-- The line: left on phones, centred on wide screens. -->
    <span aria-hidden="true" class="absolute bottom-0 left-5 top-0 w-0.5 bg-rule lg:left-1/2 lg:-translate-x-1/2" />
    {
      eras.map((era) => {
        const items = enriched.filter(({ event }) => event.data.era === era);
        return (
          <section aria-labelledby={`era-${era}`} class="relative pb-6" data-tl-era>
            <header class="relative mb-10 pt-4 lg:text-center">
              {/* Decorative watermark, drawn by CSS (content: attr()) so it is not page text. */}
              <span
                aria-hidden="true"
                data-watermark={eraLabel(era)}
                class="pointer-events-none absolute -top-3 left-0 hidden select-none whitespace-nowrap text-7xl font-[800] tracking-tight text-accent/10 before:content-[attr(data-watermark)] lg:block"
              />
              <h2 id={`era-${era}`} class="relative z-10 ml-0 inline-block scroll-mt-6 rounded-full bg-accent px-5 py-2 text-lg font-bold text-on-accent">
                {eraLabel(era)}
              </h2>
            </header>
            <ol class="relative space-y-12">
              {items.map(({ event, title, summary, issues, documents }, index) => {
                const chapter = issues[0] && chapters.get(issues[0].entry.data.slug);
                const major = event.data.importance === 1;
                const left = index % 2 === 0; // which side the card sits on (wide screens)
                return (
                  <li id={event.id} data-importance={event.data.importance} data-chapters={chaptersOf(issues).join(" ")} data-text={`${title.text} ${summary.text}`.toLocaleLowerCase(lang)} class="relative scroll-mt-24 pl-14 lg:grid lg:grid-cols-[1fr_5rem_1fr] lg:items-start lg:pl-0">
                    {/* Dot on the line */}
                    <span class="absolute left-5 top-0 -translate-x-1/2 lg:static lg:col-start-2 lg:row-start-1 lg:flex lg:translate-x-0 lg:justify-center">
                      {chapter ? (
                        <ChapterIcon slug={chapter} size={major ? "md" : "sm"} filled={major} class="ring-4 ring-bg" />
                      ) : (
                        <span aria-hidden="true" class:list={["mt-2 block rounded-full bg-accent ring-4 ring-bg", major ? "size-6" : "size-4"]} />
                      )}
                    </span>
                    {/* Date: opposite side of the card on wide screens */}
                    <p class:list={[
                      "mb-1 text-sm font-bold text-accent lg:row-start-1 lg:mb-0 lg:pt-2",
                      left ? "lg:col-start-3 lg:text-left" : "lg:col-start-1 lg:text-right",
                    ]}>
                      <time datetime={event.data.date.toISOString().slice(0, 10)}>{formatDate(event.data.date, event.data.dateCertainty)}</time>
                      {event.data.endDate && <> – <time datetime={event.data.endDate.toISOString().slice(0, 10)}>{formatDate(event.data.endDate, event.data.dateCertainty)}</time></>}
                    </p>
                    {/* Card */}
                    <div class:list={[
                      "rounded-2xl transition target:ring-2 target:ring-accent lg:row-start-1",
                      left ? "lg:col-start-1" : "lg:col-start-3",
                      major ? "bg-panel p-6 shadow-sm" : "border border-rule p-5",
                    ]}>
                      <h3 class:list={["font-bold leading-snug", major ? "text-2xl" : "text-lg"]} lang={title.isFallback ? title.lang : undefined}>
                        <a href={`#${event.id}`} class="hover:underline">{title.text}</a>
                        {event.data.draft && <span class="ml-2 align-middle text-sm font-normal text-muted">({t("draft.label")})</span>}
                      </h3>
                      <p class="mt-2" lang={summary.isFallback ? summary.lang : undefined}>{summary.text}</p>
                      {(issues.length > 0 || documents.length > 0) && (
                        <ul class="mt-4 flex flex-wrap gap-2 text-sm">
                          {issues.map((i) => (
                            <li><a href={localizePath(lang, `issues/${i.entry.data.slug}`)} lang={i.isFallback ? i.lang : undefined} class="inline-block rounded-full border border-rule bg-bg px-3 py-1 font-medium hover:border-accent hover:text-accent">{i.entry.data.title}</a></li>
                          ))}
                          {documents.map((d) => {
                            const dt = pickLocalized(d.data.title, lang);
                            return <li><a href={localizePath(lang, `documents/${d.id}`)} lang={dt.isFallback ? dt.lang : undefined} class="inline-block rounded-full bg-sunken px-3 py-1 font-medium hover:text-accent">{dt.text}</a></li>;
                          })}
                        </ul>
                      )}
                      <div class="mt-3"><SourceLinks sources={event.data.sources} /></div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })
    }
  </div>
</Layout>

<script>
  const controls = document.querySelector<HTMLElement>("[data-tl-controls]");
  const search = document.querySelector<HTMLInputElement>("[data-tl-search]");
  const major = document.querySelector<HTMLInputElement>("[data-tl-major]");
  const status = document.querySelector<HTMLElement>("[data-tl-status]");
  const empty = document.querySelector<HTMLElement>("[data-tl-empty]");
  const body = document.querySelector<HTMLElement>("[data-tl-body]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-tl-body] li[data-importance]")];
  const chapterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-tl-chapter]")];

  if (controls && search && major && status && empty && body && items.length) {
    controls.hidden = false;
    const template = controls.dataset;
    let chapter = "";
    const apply = () => {
      const query = search.value.trim().toLocaleLowerCase(document.documentElement.lang);
      let visible = 0;
      items.forEach((item) => {
        item.hidden =
          (major.checked && item.dataset.importance !== "1") ||
          (chapter !== "" && !(item.dataset.chapters ?? "").split(" ").includes(chapter)) ||
          (query !== "" && !(item.dataset.text ?? "").includes(query));
        if (!item.hidden) visible++;
      });
      document.querySelectorAll<HTMLElement>("[data-tl-era]").forEach((era) => {
        era.hidden = ![...era.querySelectorAll<HTMLElement>("li[data-importance]")].some((i) => !i.hidden);
      });
      const filtered = visible < items.length;
      status.textContent = filtered
        ? (template.shown ?? "").replace("{n}", String(visible)).replace("{total}", String(items.length))
        : "";
      empty.hidden = visible > 0;
      body.hidden = visible === 0;
    };
    search.addEventListener("input", apply);
    major.addEventListener("change", apply);
    chapterButtons.forEach((button) =>
      button.addEventListener("click", () => {
        chapter = button.dataset.tlChapter ?? "";
        chapterButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        apply();
      }),
    );
  }
</script>
