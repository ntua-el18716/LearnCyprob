---
import Layout from "@layouts/Layout.astro";
import SourceLinks from "@components/SourceLinks.astro";
import ProvisionStatus from "@components/ProvisionStatus.astro";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../lib/i18n";
import { getComparison } from "../../../lib/provisions";

export async function getStaticPaths() {
  const paths: { params: { lang: Locale; issue: string } }[] = [];
  for (const lang of publishedLocales) {
    const { issues } = await getComparison(lang);
    for (const issue of issues) paths.push({ params: { lang, issue: issue.slug } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { plans, issues, cell } = await getComparison(lang);
const issue = issues.find((i) => i.slug === Astro.params.issue);
if (!issue) return Astro.redirect(localizePath(lang, "compare"));
const title = t("compare.issueTitle", { issue: issue.title });
const alternates = Object.fromEntries(publishedLocales.map((l) => [l, localizePath(l, `compare/${issue.slug}`)]));
const link = "link";
---

<Layout lang={lang} title={title} alternates={alternates}>
  <h1 class="text-3xl font-bold tracking-tight text-ink">{title}</h1>
  <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
    <a href={localizePath(lang, `issues/${issue.slug}`)} lang={issue.isFallback ? issue.lang : undefined} class={link}>{issue.title}</a>
    <a href={localizePath(lang, "compare")} class={link}>{t("compare.backToMatrix")}</a>
  </p>
  <ol class="mt-8 space-y-8">
    {
      plans.map((plan) => {
        const provision = cell(issue.slug, plan.id);
        const summary = provision && pickLocalized(provision.data.summary, lang);
        return (
          <li class="border-l-2 border-rule pl-4">
            <h2 class="text-lg font-semibold">
              <a href={localizePath(lang, `documents/${plan.id}`)} lang={plan.lang} class={link}>{plan.title}</a>
            </h2>
            {provision && summary ? (
              <div class="mt-2 space-y-2">
                <ProvisionStatus status={provision.data.status} isReferenceModel={provision.data.isReferenceModel} />
                <p lang={summary.isFallback ? summary.lang : undefined}>{summary.text}</p>
                {provision.data.anchors.length > 0 && (
                  <p class="text-sm">
                    {t("compare.paragraphs")}:{" "}
                    {provision.data.anchors.map((a, i) => (<>{i > 0 && ", "}<a href={`${localizePath(lang, `documents/${plan.id}`)}#${a}`} class={link}>¶ {a.replace(/-/g, " ")}</a></>))}
                  </p>
                )}
                <SourceLinks sources={provision.data.sources} />
              </div>
            ) : (
              <p class="mt-2 text-sm text-muted">{t("compare.notCovered")}</p>
            )}
          </li>
        );
      })
    }
  </ol>
</Layout>
