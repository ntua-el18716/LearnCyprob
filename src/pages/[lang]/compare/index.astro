---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import ProvisionStatus from "@components/ProvisionStatus.astro";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../lib/i18n";
import { getComparison } from "../../../lib/provisions";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { plans, issues, cell } = await getComparison(lang);
const alternates = Object.fromEntries(publishedLocales.map((l) => [l, localizePath(l, "compare")]));
const link = "link";
---

<Layout lang={lang} title={t("compare.title")} description={t("compare.description")} alternates={alternates}>
  <PageHeader title={t("compare.title")} intro={t("compare.description")} introLang={t.langOf("compare.description")} />
  {
    issues.length === 0 ? (
      <p>{t("compare.empty")}</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
          <caption class="sr-only">{t("compare.title")}</caption>
          <thead>
            <tr class="border-b border-control">
              <th scope="col" class="py-2 pr-3 align-bottom">{t("compare.issue")}</th>
              {plans.map((plan) => (
                <th scope="col" class="py-2 pr-3 align-bottom">
                  <a href={localizePath(lang, `documents/${plan.id}`)} lang={plan.lang} class={link}>
                    {plan.title}
                  </a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {issues.map((issue) => (
              <tr class="border-b border-rule align-top">
                <th scope="row" class="py-3 pr-3 font-medium">
                  <a href={localizePath(lang, `compare/${issue.slug}`)} lang={issue.isFallback ? issue.lang : undefined} class={link}>
                    {issue.title}
                  </a>
                </th>
                {plans.map((plan) => {
                  const provision = cell(issue.slug, plan.id);
                  if (!provision) {
                    return <td class="py-3 pr-3 text-muted">{t("compare.notCovered")}</td>;
                  }
                  const summary = pickLocalized(provision.data.summary, lang);
                  return (
                    <td class="py-3 pr-3 space-y-1">
                      <ProvisionStatus status={provision.data.status} isReferenceModel={provision.data.isReferenceModel} />
                      <p lang={summary.isFallback ? summary.lang : undefined}>{summary.text}</p>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Layout>
