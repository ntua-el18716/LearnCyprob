---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import ProvisionStatus from "@components/ProvisionStatus.astro";
import ChapterIcon from "@components/ChapterIcon.astro";
import { chapterOf } from "../../../lib/chapters";
import { getIssueTree } from "../../../lib/issues";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { localizePath, pickLocalized, useTranslations } from "../../../lib/i18n";
import { getComparison } from "../../../lib/provisions";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { plans, issues, cell } = await getComparison(lang);
const chapters = chapterOf(await getIssueTree(lang));
const alternates = Object.fromEntries(publishedLocales.map((l) => [l, localizePath(l, "compare")]));
---

<Layout lang={lang} title={t("compare.title")} description={t("compare.description")} alternates={alternates}>
  <PageHeader title={t("compare.title")} intro={t("compare.description")} introLang={t.langOf("compare.description")} />
  {
    issues.length === 0 ? (
      <p>{t("compare.empty")}</p>
    ) : (
      <div class="overflow-x-auto">
        <!-- Separated cells: each provision reads as its own card. -->
        <table class="w-full min-w-[44rem] border-separate border-spacing-2 text-left">
          <caption class="sr-only">{t("compare.title")}</caption>
          <thead>
            <tr>
              <th scope="col" class="w-56 px-2 pb-2 align-bottom text-sm text-muted">{t("compare.issue")}</th>
              {plans.map((plan) => (
                <th scope="col" class="px-2 pb-2 align-bottom">
                  <a href={localizePath(lang, `documents/${plan.id}`)} lang={plan.lang} class="text-lg font-bold link">
                    {plan.title}
                  </a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {issues.map((issue) => (
              <tr class="align-top">
                <th scope="row" class="px-2 py-4">
                  <span class="flex items-start gap-3">
                    <ChapterIcon slug={chapters.get(issue.slug) ?? issue.slug} size="sm" />
                    <a href={localizePath(lang, `compare/${issue.slug}`)} lang={issue.isFallback ? issue.lang : undefined} class="pt-1.5 font-semibold link">
                      {issue.title}
                    </a>
                  </span>
                </th>
                {plans.map((plan) => {
                  const provision = cell(issue.slug, plan.id);
                  if (!provision) {
                    return <td class="rounded-xl border-2 border-dashed border-rule p-4 text-muted">{t("compare.notCovered")}</td>;
                  }
                  const summary = pickLocalized(provision.data.summary, lang);
                  return (
                    <td class="space-y-2 rounded-xl bg-panel p-4">
                      <ProvisionStatus status={provision.data.status} isReferenceModel={provision.data.isReferenceModel} />
                      <p class="text-[0.95rem] leading-snug" lang={summary.isFallback ? summary.lang : undefined}>{summary.text}</p>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Layout>
