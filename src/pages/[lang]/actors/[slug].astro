---
// One actor: who it is, and its recorded positions on every issue over time
// (positions come only from positions/*.yaml), plus documents and timeline
// events that name it.
import Layout from "@layouts/Layout.astro";
import PageNotice from "@components/PageNotice.astro";
import { getCollection } from "astro:content";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { isVisible } from "../../../lib/drafts";
import { localizePath, pickLocalized, useTranslations } from "../../../lib/i18n";
import { groupOf } from "../../../lib/positions";
import { getActorLinks, getActorPositions } from "../../../lib/actors";

export async function getStaticPaths() {
  const actors = await getCollection("actors", isVisible);
  return publishedLocales.flatMap((lang) =>
    actors.map((actor) => ({ params: { lang, slug: actor.id }, props: { actor } })),
  );
}

const { actor } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { data } = actor;
const name = pickLocalized(data.name, lang);
const short = pickLocalized(data.shortName, lang);
const issues = await getActorPositions(actor, lang);
const { documents, events } = await getActorLinks(actor, lang);
const group = groupOf(actor);

const formatDate = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const year = (d: Date) => d.getUTCFullYear();
const sourceHref = (id: string) => `${localizePath(lang, "sources")}#${id}`;
const langAttr = (v: { isFallback: boolean; lang: string }) => (v.isFallback ? v.lang : undefined);
const alternates = Object.fromEntries(publishedLocales.map((l) => [l, localizePath(l, `actors/${actor.id}`)]));
---

<Layout lang={lang} title={name.text} alternates={alternates} noindex={data.draft}>
  {data.draft && <PageNotice kind="draft">{t("draft.banner")}</PageNotice>}

  <header class="mb-10 sm:mb-12">
    <p class="text-sm font-semibold">
      <a href={localizePath(lang, "actors")} class="link">{t("actors.title")}</a>
      <span class="text-muted"> / <span lang={t.langOf(`board.group.${group}`)}>{t(`board.group.${group}`)}</span></span>
    </p>
    <h1 class="page-title mt-3" lang={langAttr(name)}>{name.text}</h1>
    <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-rule bg-rule sm:grid-cols-4">
      <div class="bg-bg p-4">
        <dt class="text-sm font-semibold text-muted">{t("actors.shortName")}</dt>
        <dd class="mt-1 flex items-center gap-2 text-lg font-semibold">
          {data.color && <span aria-hidden="true" class="size-3 rounded-sm" style={{ background: data.color }} />}
          <span lang={langAttr(short)}>{short.text}</span>
        </dd>
      </div>
      <div class="bg-bg p-4">
        <dt class="text-sm font-semibold text-muted">{t("actors.typeLabel")}</dt>
        <dd class="mt-1 text-lg font-semibold" lang={t.langOf(`actors.type.${data.type}`)}>{t(`actors.type.${data.type}`)}</dd>
      </div>
      <div class="bg-bg p-4">
        <dt class="text-sm font-semibold text-muted">{t("actors.active")}</dt>
        <dd class="mt-1 text-lg font-semibold">
          {data.active.to ? `${year(data.active.from)}–${year(data.active.to)}` : t("actors.since", { year: year(data.active.from) })}
        </dd>
      </div>
      <div class="bg-bg p-4">
        <dt class="text-sm font-semibold text-muted">{t("actors.issues")}</dt>
        <dd class="mt-1 text-lg font-semibold">{issues.length}</dd>
      </div>
    </dl>
  </header>

  <section aria-labelledby="positions" class="mb-14">
    <h2 id="positions" class="text-2xl font-[720]">{t("actors.positions")}</h2>
    <p class="mt-1 text-muted" lang={t.langOf("actors.positionsNote")}>{t("actors.positionsNote")}</p>
    {issues.length === 0 && <p class="mt-6 rounded-2xl border border-dashed border-rule p-6 text-muted">{t("actors.noPositions")}</p>}
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      {
        issues.map((issue) => (
          <article class="rounded-2xl border border-rule p-5 sm:p-6">
            <h3 class="text-xl font-bold leading-snug" lang={issue.title.lang}>
              {issue.hasArticle ? <a href={localizePath(lang, `issues/${issue.slug}`)} class="link">{issue.title.text}</a> : issue.title.text}
            </h3>
            <a href={issue.board} class="mt-1 inline-block text-sm font-semibold link">{t("board.fullPage")}</a>
            <ol class="relative mt-5 space-y-6 border-l-2 border-rule pl-5">
              {issue.positions.map((p, i) => {
                const current = !p.validTo && i === issue.positions.length - 1;
                return (
                  <li class="relative">
                    <span aria-hidden="true" class:list={["absolute top-1.5 size-3 rounded-full ring-4 ring-bg", current ? "bg-accent" : "bg-control"]} style="left: calc(-1.25rem - 7px)" />
                    <p class="text-sm font-semibold text-muted">
                      {p.validTo ? (
                        t("board.validRange", { from: formatDate.format(p.validFrom), to: formatDate.format(p.validTo) })
                      ) : (
                        t("board.validFrom", { date: formatDate.format(p.validFrom) })
                      )}
                      {current && <span class="ml-2 rounded-full bg-panel px-2 py-0.5 text-xs font-bold text-accent">{t("actors.current")}</span>}
                    </p>
                    <p class="mt-1 font-semibold" lang={p.option?.lang}>{p.option?.text ?? t("board.noStated")}</p>
                    <p class="mt-1 text-sm">
                      <span class="text-muted">{t("actors.certainty")}:</span>{" "}
                      <span lang={t.langOf(`certainty.${p.certainty}`)}>{t(`certainty.${p.certainty}`)}</span>
                    </p>
                    {p.note && <p class="mt-2 text-sm" lang={p.note.lang}>{p.note.text}</p>}
                    {p.quote && (
                      <blockquote class="mt-3 border-l-2 border-accent pl-3 text-sm">
                        <p lang={p.quote.lang}>“{p.quote.original}”</p>
                        {p.quote.translation && p.quote.lang !== lang && (
                          <p class="mt-1 text-muted" lang={p.quote.translation.lang}>{p.quote.translation.text}</p>
                        )}
                      </blockquote>
                    )}
                    <p class="mt-2 text-sm">
                      <span class="text-muted">{t("sources.heading")}:</span>{" "}
                      {p.sources.map((s, j) => (
                        <>
                          {j > 0 && "; "}
                          <a href={sourceHref(s.id)} class="link" lang={s.lang}>{s.title}</a>
                        </>
                      ))}
                    </p>
                  </li>
                );
              })}
            </ol>
          </article>
        ))
      }
    </div>
  </section>

  {
    [
      { id: "documents", heading: t("related.documents"), items: documents },
      { id: "events", heading: t("nav.timeline"), items: events },
    ]
      .filter((s) => s.items.length > 0)
      .map((s) => (
        <section aria-labelledby={`actor-${s.id}`} class="mb-12">
          <h2 id={`actor-${s.id}`} class="text-2xl font-[720]">{s.heading}</h2>
          <ul class="mt-4 divide-y divide-rule border-y border-rule">
            {s.items.map((item) => (
              <li class="flex flex-wrap gap-x-4 py-3">
                <time datetime={iso(item.date)} class="w-28 shrink-0 text-sm font-semibold text-muted">{year(item.date)}</time>
                <a href={item.href} class="link" lang={item.title.lang}>{item.title.text}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
</Layout>
