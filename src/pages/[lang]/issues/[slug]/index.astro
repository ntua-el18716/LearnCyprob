---
import Layout from "@layouts/Layout.astro";
import PageNotice from "@components/PageNotice.astro";
import PositionBoard from "@components/PositionBoard.astro";
import ArticleOutline from "@components/ArticleOutline.astro";
import ChapterIcon from "@components/ChapterIcon.astro";
import Analysis from "@components/content/Analysis.astro";
import Cite from "@components/content/Cite.astro";
import Claim from "@components/content/Claim.astro";
import Concern from "@components/content/Concern.astro";
import SourcesList from "@components/content/SourcesList.astro";
import Status from "@components/content/Status.astro";
import { getCollection, render } from "astro:content";
import { repoUrl } from "@data/constants";
import { publishedLocales, type Locale } from "../../../../i18n/locales";
import { localizePath, useTranslations } from "../../../../lib/i18n";
import { getIssue, getIssueSlugs } from "../../../../lib/issues";
import { isVisible } from "../../../../lib/drafts";
import { getPositionBoard } from "../../../../lib/positions";
import type { Citation } from "../../../../lib/remark-citations";

export async function getStaticPaths() {
  const slugs = await getIssueSlugs();
  return publishedLocales.flatMap((lang) =>
    slugs.map((slug) => ({ params: { lang, slug } })),
  );
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const t = useTranslations(lang);

const issue = (await getIssue(slug, lang))!;
const { entry, lang: contentLang, isFallback } = issue;
const { data } = entry;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const citations = (remarkPluginFrontmatter.citations ?? []) as Citation[];
const statusCitation = remarkPluginFrontmatter.statusCitation as
  | { numbers: string; refs: string }
  | undefined;

// Ancestors, chapter first (for the breadcrumb and the chapter icon).
const ancestors: NonNullable<Awaited<ReturnType<typeof getIssue>>>[] = [];
for (let next = data.parent; next; ) {
  const found = await getIssue(next, lang);
  if (!found || ancestors.some((a) => a.entry.data.slug === next)) break;
  ancestors.unshift(found);
  next = found.entry.data.parent;
}
const chapterSlug = ancestors[0]?.entry.data.slug ?? slug;
const hasProvisions = (await getCollection("provisions", (p) => p.data.issue === slug && isVisible(p))).length > 0;
const related = (
  await Promise.all(data.related.map((s) => getIssue(s, lang)))
).filter((r) => r !== undefined);

const hasBoard = (await getPositionBoard(slug, lang)) !== undefined;

// "On this page": the article's h2 sections, then the fixed sections.
const outline = [
  ...headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ id: h.slug, text: h.text.replace(/^#\s*/, ""), lang: isFallback ? contentLang : undefined })),
  ...(hasBoard ? [{ id: `positions-${slug}`, text: t("board.title") }] : []),
  ...(related.length > 0 ? [{ id: "related", text: t("issue.related") }] : []),
  ...(citations.length > 0 ? [{ id: "sources", text: t("sources.heading") }] : []),
];

// Every issue article needs a "Concerns & criticisms" section (CLAUDE.md).
// Heading text includes the "#" anchor that rehype-autolink-headings adds.
const concernsHeading = useTranslations(contentLang)("issue.concernsHeading");
const hasConcerns = headings.some(
  (h) => h.text.replace(/^#\s*/, "").trim() === concernsHeading,
);
if (!hasConcerns) {
  console.warn(
    `[issues] ${entry.id}: missing a "${concernsHeading}" section (required for every issue).`,
  );
}

// Mark content that fell back to another language (UI strings stay in `lang`).
const contentLangAttr = isFallback ? contentLang : undefined;
const formatDate = new Intl.DateTimeFormat(lang, { dateStyle: "long" });
const issueLink = (s: string) => localizePath(lang, `issues/${s}`);
const alternates = Object.fromEntries(
  publishedLocales.map((l) => [l, localizePath(l, `issues/${slug}`)]),
);
---

<Layout
  lang={lang}
  title={data.title}
  description={data.summary}
  alternates={alternates}
  noindex={data.draft}
  ogImage={{ src: `${issueLink(slug)}og.png`, alt: data.title }}
>
  <article>
    <header class="page-band">
      {data.draft && <PageNotice kind="draft">{t("draft.banner")}</PageNotice>}
      {isFallback && <PageNotice kind="translation">{t("translation.missing")}</PageNotice>}
      {
        import.meta.env.DEV && !hasConcerns && (
          <PageNotice kind="draft" lang="en">
            Dev only: this issue has no “{concernsHeading}” section. Every issue
            article needs one (CLAUDE.md).
          </PageNotice>
        )
      }
      <div class="mb-5 flex items-center gap-3">
        <ChapterIcon slug={chapterSlug} size={ancestors.length ? "sm" : "md"} />
        {
          ancestors.length > 0 && (
            <nav aria-label={t("issue.partOf")} class="font-semibold text-accent">
              <ol class="flex flex-wrap items-center gap-x-2">
                {ancestors.map((a, i) => (
                  <li class="flex items-center gap-x-2">
                    {i > 0 && <span aria-hidden="true" class="text-muted">/</span>}
                    <a href={issueLink(a.entry.data.slug)} lang={a.isFallback ? a.lang : undefined} class="hover:underline">
                      {a.entry.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
      <h1 lang={contentLangAttr} class="max-w-4xl text-4xl sm:text-[3.4rem] font-[780] tracking-[-0.025em] leading-[1.04]">
        {data.title}
      </h1>
      <p lang={contentLangAttr} class="mt-4 max-w-2xl text-xl sm:text-[1.35rem] leading-snug text-ink">
        {data.summary}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-10 gap-y-4">
        {
          data.status && (
            <Status
              large
              value={data.status}
              sources={data.statusSources.map((s) => s.id)}
              numbers={statusCitation?.numbers}
              refs={statusCitation?.refs}
            />
          )
        }
        <p class="text-sm leading-relaxed text-muted">
          <time datetime={data.lastReviewed.toISOString().slice(0, 10)} class="block">
            {t("issue.lastReviewed", { date: formatDate.format(data.lastReviewed) })}
          </time>
          <a href={`${repoUrl}/commits/main/${entry.filePath}`} class="link">{t("issue.history")}</a>
        </p>
      </div>
    </header>

    <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-14">
      <ArticleOutline items={outline} />
      <div class="min-w-0 max-w-prose lg:max-w-[42rem]">
        <div lang={contentLangAttr} class="prose prose-site max-w-none">
          <Content components={{ Analysis, Cite, Claim, Concern, Status }} />
        </div>

        <PositionBoard issue={slug} linkToFullPage />

        {
          hasProvisions && (
            <p class="mt-8">
              <a href={localizePath(lang, `compare/${slug}`)} class="font-semibold link">{t("compare.details")}</a>
            </p>
          )
        }

        {
          related.length > 0 && (
            <nav aria-labelledby="related" class="mt-14 scroll-mt-6">
              <h2 id="related" class="text-2xl font-[720]">{t("issue.related")}</h2>
              <ul class="mt-4 divide-y divide-rule border-y border-rule">
                {related.map((r) => (
                  <li class="py-3" lang={r.isFallback ? r.lang : undefined}>
                    <a href={issueLink(r.entry.data.slug)} class="font-semibold link">{r.entry.data.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <SourcesList citations={citations} />
      </div>
    </div>
  </article>
</Layout>
