---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import IssueTreeList from "@components/IssueTreeList.astro";
import { publishedLocales, type Locale } from "../../../i18n/locales";
import { localizePath, useTranslations } from "../../../lib/i18n";
import { getIssueTree } from "../../../lib/issues";

export function getStaticPaths() {
  return publishedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const tree = await getIssueTree(lang);
const alternates = Object.fromEntries(
  publishedLocales.map((l) => [l, localizePath(l, "issues")]),
);
---

<Layout lang={lang} title={t("issues.title")} description={t("issues.description")} alternates={alternates}>
  <PageHeader icon="lucide:list-tree" title={t("issues.title")} intro={t("issues.description")} introLang={t.langOf("issues.description")} />
  <div class="max-w-3xl">
  <IssueTreeList nodes={tree} lang={lang} />
  </div>
</Layout>
