---
import Layout from "@layouts/Layout.astro";
import IslandMark from "@components/IslandMark.astro";
import { Icon } from "astro-icon/components";
import { localizePath } from "../lib/i18n";
import { defaultLocale } from "../i18n/locales";
import { useTranslations } from "../lib/i18n";

// A static host serves one 404 page for every path, so it uses the default locale.
const t = useTranslations(defaultLocale);
const title = t("notFound.title");
const description = t("notFound.description");
---

<Layout title={title} description={description} unsearchable>
  <div class="mx-auto flex max-w-xl flex-col items-center py-6 text-center sm:py-12">
    <IslandMark variant="dotted" id="notfound-island" class="w-full max-w-sm text-accent opacity-70" />
    <p class="mt-8 text-sm font-bold tracking-[0.2em] text-accent" aria-hidden="true">404</p>
    <h1 class="page-title mt-2">{title}</h1>
    <p class="mt-4 text-xl text-muted">{t("notFound.body")}</p>
    <a href={localizePath(defaultLocale)} class="btn mt-8">
      <Icon name="lucide:arrow-left" class="size-5" aria-hidden="true" />
      {t("nav.home")}
    </a>
  </div>
</Layout>
