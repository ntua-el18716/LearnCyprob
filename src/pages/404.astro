---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { localizePath } from "../lib/i18n";
import { defaultLocale } from "../i18n/locales";
import { useTranslations } from "../lib/i18n";

// A static host serves one 404 page for every path, so it uses the default locale.
const t = useTranslations(defaultLocale);
const title = t("notFound.title");
const description = t("notFound.description");
---

<Layout title={title} description={description}>
  <PageHeader title={title} intro={t("notFound.body")}>
    <a href={localizePath(defaultLocale)} class="mt-6 inline-block font-semibold link">{t("nav.home")}</a>
  </PageHeader>
</Layout>
