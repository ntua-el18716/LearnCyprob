---
// Root: send visitors to their browser language if it is published, else to
// the default locale. A static site can't read Accept-Language, so this runs
// in the browser; without JS the meta refresh goes to the default locale.
import {
  defaultLocale,
  localeMeta,
  publishedLocales,
} from "../i18n/locales";
import { localizePath, useTranslations } from "../lib/i18n";

const fallback = localizePath(defaultLocale);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{useTranslations(defaultLocale)("site.title")}</title>
    <meta name="robots" content="noindex" />
    {
      publishedLocales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localizePath(l), Astro.site).href}
        />
      ))
    }
    <script is:inline define:vars={{ published: publishedLocales, fallback }}>
      const match = navigator.languages
        .map((l) => l.toLowerCase().split("-")[0])
        .find((l) => published.includes(l));
      location.replace(match ? `/${match}/` : fallback);
    </script>
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
  </head>
  <body>
    <ul>
      {
        publishedLocales.map((l) => (
          <li lang={l}>
            <a href={localizePath(l)} hreflang={l}>
              {useTranslations(l)("langPicker.title")}: {localeMeta[l].name}
            </a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
