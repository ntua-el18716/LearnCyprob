---
import Link from "@components/Link.astro";
import { Icon } from "astro-icon/components";
import { author, defaultMeta, repoUrl } from "@data/constants";
import { localizePath, useTranslations } from "../lib/i18n";
import { getPageSlugs } from "../lib/pages";
import {
  defaultLocale,
  localeMeta,
  publishedLocales,
  type Locale,
} from "../i18n/locales";
import "@styles/global.css";
import "@fontsource-variable/noto-sans";
import "@fontsource-variable/noto-serif";
import Callout from "@components/MDX/Callout.astro";


interface Props {
  title?: string;
  description?: string;
  ogImage?: {
    src: string;
    alt: string;
  };
  pubDate?: Date;
  wide?: boolean;
  lang?: Locale;
  /** Keep the page out of search engines (drafts). */
  noindex?: boolean;
  /** This page in other languages; defaults to each language's home page. */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  lang = defaultLocale,
  noindex = false,
  pubDate,
  wide = false,
  alternates = Object.fromEntries(
    publishedLocales.map((l) => [l, localizePath(l)]),
  ),
} = Astro.props;
const t = useTranslations(lang);
const {
  title = t("site.title"),
  description = t("site.description"),
  ogImage = defaultMeta.ogImage,
} = Astro.props;

const pageSlugs = await getPageSlugs();
const navigation = [
  { href: localizePath(lang), text: t("nav.home"), exact: true },
  { href: localizePath(lang, "issues"), text: t("nav.issues") },
  { href: localizePath(lang, "documents"), text: t("nav.documents") },
  { href: localizePath(lang, "timeline"), text: t("nav.timeline") },
  { href: localizePath(lang, "glossary"), text: t("nav.glossary") },
];

// Footer: site pages that exist (about, methodology, corrections), in this order.
const footerPages = (["about", "methodology", "corrections"] as const).filter((slug) =>
  pageSlugs.includes(slug),
);

const ogImageURL = new URL(ogImage.src, Astro.site).href;
const canonicalURL = new URL(Astro.url).href;
---

<!doctype html>
<html lang={lang} class="dark:[color-scheme:dark] scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Apply the theme before first paint to avoid a light flash.
      {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private mode); use the system preference.
        }
        const isDark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      }
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={author} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    {
      Object.entries(alternates).map(([l, href]) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(href, Astro.site).href}
        />
      ))
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "follow, index"} />
    <meta name="author" content={author} />
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
  </head>
  <body
    class="dark:bg-zinc-950 bg-zinc-50 antialiased selection:bg-zinc-700 selection:text-zinc-100 dark:selection:bg-zinc-500 dark:selection:text-white pt-10 2xl:text-lg"
  >
    <a
      href="#main-content"
      class="absolute opacity-0 focus:opacity-100 border-transparent border-y border-r dark:focus:border-zinc-900 text-xs lg:text-sm px-4 py-1.5 lg:py-2 top-1 lg:top-[41px] transition-transform duration-300 rounded-r-full bg-zinc-300 dark:bg-zinc-800 font-medium text-zinc-800 dark:text-zinc-200 focus:outline-none -translate-x-full focus:translate-x-0"
      >{t("a11y.skipToContent")}</a
    >
    <nav
      aria-label={t("nav.label")}
      class="mb-16 mx-auto flex flex-wrap items-center justify-between gap-x-6 px-6 lg:px-2"
      class:list={{
        "max-w-4xl": wide,
        "max-w-3xl": !wide,
      }}
    >
      <ul class="flex flex-wrap gap-x-6">
        {
          navigation.map((item) => (
            <li>
              <Link {...item} />
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-4">
        <ul class="flex gap-3 text-sm" aria-label={t("nav.language")}>
          {
            publishedLocales.map((l) => (
              <li>
                <a
                  href={alternates[l] ?? localizePath(l)}
                  hreflang={l}
                  lang={l}
                  aria-current={l === lang ? "true" : undefined}
                  class:list={[
                    "block py-2.5 transition-colors",
                    l === lang
                      ? "font-semibold dark:text-zinc-50 text-zinc-950"
                      : "dark:text-zinc-400 text-zinc-600 hover:text-zinc-800 dark:hover:text-zinc-50",
                  ]}
                >
                  {localeMeta[l].name}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          id="dark-mode-toggle"
          class="focus:outline-none dark:text-zinc-100 text-zinc-900 dark:hover:text-zinc-300 hover:text-zinc-600"
          aria-label={t("theme.toggle")}
        >
          <Icon name="moon" class="w-6 h-6 sun-icon" />
          <Icon name="sun" class="w-6 h-6 moon-icon" />
        </button>
      </div>
    </nav>
    <main
      class="px-6 lg:px-2 mx-auto dark:text-zinc-400 text-zinc-600"
      id="main-content"
      class:list={{
        "max-w-4xl": wide,
        "max-w-3xl": !wide,
      }}
    >
      <noscript>
        <Callout type="error" title={t("noscript.title")}>
          {t("noscript.body")}
        </Callout>
      </noscript>
      <slot />
    </main>
    <footer class="mt-12 pb-12">
      <div
        class="mx-auto max-w-4xl px-6 lg:px-2 text-center text-xs lg:text-sm dark:text-zinc-400 text-zinc-600"
      >
        {
          footerPages.length > 0 && (
            <ul class="mb-3 flex flex-wrap justify-center gap-x-6">
              {footerPages.map((slug) => (
                <li>
                  <a href={localizePath(lang, slug)} class="hover:underline">
                    {t(`footer.${slug}`)}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p>
          {t("footer.copyright", { year: new Date().getFullYear(), author })}
          <a
            href={repoUrl}
            class="hover:underline z-10">{t("footer.source")}</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  // Theme toggle. The choice is kept in localStorage (no cookies, see
  // CLAUDE.md); without a stored choice the system preference applies.
  {
    const darkModeToggle = document.getElementById("dark-mode-toggle");
    const sunIcon = document.querySelector(".sun-icon");
    const moonIcon = document.querySelector(".moon-icon");

    const showIcons = (isDark) => {
      sunIcon?.classList.toggle("hidden", isDark);
      moonIcon?.classList.toggle("hidden", !isDark);
      darkModeToggle?.setAttribute("aria-pressed", String(isDark));
    };

    showIcons(document.documentElement.classList.contains("dark"));

    darkModeToggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      showIcons(isDark);
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // Storage can be unavailable (private mode); the toggle still works.
      }
    });
  }
</script>

<style>
  body::-webkit-scrollbar {
    width: 8px;
  }

  body::-webkit-scrollbar-thumb {
    @apply bg-zinc-400;
  }

  .dark body::-webkit-scrollbar-thumb {
    @apply bg-zinc-800;
  }
</style>
