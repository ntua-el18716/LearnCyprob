---
import Link from "@components/Link.astro";
import IslandMark from "@components/IslandMark.astro";
import { Icon } from "astro-icon/components";
import { author, defaultMeta, repoUrl } from "@data/constants";
import { localizePath, useTranslations } from "../lib/i18n";
import { getPageSlugs } from "../lib/pages";
import {
  defaultLocale,
  localeMeta,
  publishedLocales,
  type Locale,
} from "../i18n/locales";
import "@styles/global.css";
import "@fontsource-variable/commissioner";

interface Props {
  title?: string;
  description?: string;
  ogImage?: {
    src: string;
    alt: string;
  };
  pubDate?: Date;
  lang?: Locale;
  /** Keep the page out of search engines (drafts). */
  noindex?: boolean;
  /** Leave the page out of the site search index (search page, 404). */
  unsearchable?: boolean;
  /** This page in other languages; defaults to each language's home page. */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  lang = defaultLocale,
  noindex = false,
  unsearchable = false,
  pubDate,
  alternates = Object.fromEntries(
    publishedLocales.map((l) => [l, localizePath(l)]),
  ),
} = Astro.props;
const t = useTranslations(lang);
const {
  title = t("site.title"),
  description = t("site.description"),
  ogImage = defaultMeta.ogImage,
} = Astro.props;

const pageSlugs = await getPageSlugs();
// Main sections, in the header. Reference pages go in the menu and footer.
const navigation = [
  { href: localizePath(lang, "explore"), text: t("nav.issues") },
  { href: localizePath(lang, "documents"), text: t("nav.documents") },
  { href: localizePath(lang, "compare"), text: t("nav.compare") },
  { href: localizePath(lang, "timeline"), text: t("nav.timeline") },
  { href: localizePath(lang, "events"), text: t("nav.events") },
];
const reference = [
  { href: localizePath(lang, "glossary"), text: t("nav.glossary") },
  { href: localizePath(lang, "actors"), text: t("nav.actors") },
  { href: localizePath(lang, "sources"), text: t("nav.sources") },
];

// Footer: site pages that exist (about, methodology, corrections), in this order.
const footerPages = (["about", "methodology", "corrections"] as const)
  .filter((slug) => pageSlugs.includes(slug))
  .map((slug) => ({ href: localizePath(lang, slug), text: t(`footer.${slug}`) }));
const searchHref = localizePath(lang, "search");

const ogImageURL = new URL(ogImage.src, Astro.site).href;
const canonicalURL = new URL(Astro.url).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Apply the theme before first paint to avoid a light flash.
      {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private mode); use the system preference.
        }
        const isDark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      }
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={author} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    {
      Object.entries(alternates).map(([l, href]) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(href, Astro.site).href}
        />
      ))
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "follow, index"} />
    <meta name="author" content={author} />
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-bg focus:px-4 focus:py-2 focus:text-ink focus:shadow"
      >{t("a11y.skipToContent")}</a
    >
    <header class="relative z-30 bg-accent text-on-accent dark:border-b dark:border-accent/40 dark:bg-panel dark:text-ink">
      <div class="mx-auto flex max-w-6xl items-center gap-x-3 px-4 py-2.5 sm:gap-x-6 sm:px-8 lg:py-3">
        <a href={localizePath(lang)} class="group flex items-center gap-2 whitespace-nowrap text-lg font-[760] tracking-tight">
          <IslandMark class="h-5 w-auto transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-110 motion-reduce:transform-none" />
          {t("site.title")}
        </a>
        <nav aria-label={t("nav.label")} class="hidden lg:block">
          <ul class="flex gap-x-5">
            {navigation.map((item) => <li><Link {...item} /></li>)}
          </ul>
        </nav>
        <div class="ml-auto flex items-center gap-0.5 sm:gap-2">
          <a href={searchHref} class="rounded-full p-2 transition-colors hover:bg-white/20 dark:hover:bg-white/10" aria-label={t("search.title")}>
            <Icon name="lucide:search" class="size-5" />
          </a>
          <ul class="flex items-center gap-1 text-sm font-semibold" aria-label={t("nav.language")}>
            {
              publishedLocales.map((l) => (
                <li>
                  <a
                    href={alternates[l] ?? localizePath(l)}
                    hreflang={l}
                    lang={l}
                    aria-current={l === lang ? "true" : undefined}
                    class:list={[
                      "block rounded-full px-2 py-1.5 transition sm:px-2.5",
                      l === lang ? "bg-white/20 dark:bg-white/10" : "opacity-80 hover:opacity-100",
                    ]}
                  >
                    {localeMeta[l].short}<span class="sr-only"> {localeMeta[l].name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <button id="dark-mode-toggle" class="rounded-full p-2 transition-colors hover:bg-white/20 dark:hover:bg-white/10" aria-label={t("theme.toggle")}>
            <Icon name="moon" class="w-5 h-5 sun-icon" />
            <Icon name="sun" class="w-5 h-5 moon-icon" />
          </button>
          <!-- Narrow screens: a menu. <details> opens without JavaScript. -->
          <details class="site-menu lg:hidden" data-site-menu>
            <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-2 py-1.5 sm:px-3 font-semibold hover:bg-white/20 dark:hover:bg-white/10 [&::-webkit-details-marker]:hidden">
              <Icon name="lucide:menu" class="size-5 menu-open-icon" />
              <Icon name="lucide:x" class="size-5 menu-close-icon" />
              <span class="sr-only min-[420px]:not-sr-only">{t("nav.menu")}</span>
            </summary>
            <div class="absolute inset-x-0 top-full border-b border-rule bg-bg text-ink shadow-lg">
              <nav aria-label={t("nav.label")} class="mx-auto max-w-6xl px-4 py-4 sm:px-8">
                <ul class="grid gap-1 sm:grid-cols-2">
                  {navigation.map((item) => (
                    <li>
                      <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined} class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sunken aria-[current=page]:bg-panel aria-[current=page]:text-accent">
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
                <ul class="mt-3 flex flex-wrap gap-x-1 gap-y-1 border-t border-rule pt-3">
                  {[...reference, ...footerPages].map((item) => (
                    <li>
                      <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined} class="block rounded-md px-3 py-2 font-medium text-muted hover:bg-sunken hover:text-ink aria-[current=page]:text-accent">
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-8 py-10 sm:py-14" data-pagefind-body={unsearchable ? undefined : ""}>
      <noscript>
        <p class="mb-8 rounded-xl bg-sunken px-4 py-3 text-sm" data-pagefind-ignore>{t("noscript.body")}</p>
      </noscript>
      <slot />
    </main>
    <footer class="relative mt-16 overflow-hidden bg-accent text-on-accent dark:border-t dark:border-accent/40 dark:bg-panel dark:text-ink">
      <IslandMark variant="dotted" id="footer-island" class="pointer-events-none absolute -bottom-10 -right-16 w-[30rem] max-w-none opacity-[0.13] sm:-bottom-16 sm:w-[44rem] dark:text-accent dark:opacity-20" />
      <div class="relative mx-auto grid max-w-6xl grid-cols-2 gap-x-8 gap-y-10 px-4 py-12 text-sm sm:grid-cols-[1fr_auto_auto_auto] sm:gap-x-14 sm:px-8 sm:py-16">
        <div class="col-span-2 sm:col-span-1">
          <a href={localizePath(lang)} class="inline-flex items-center gap-2.5 text-2xl font-[780] tracking-tight">
            <IslandMark class="h-7 w-auto" />
            {t("site.title")}
          </a>
          <p class="mt-4 max-w-xs opacity-80">
            {t("footer.copyright", { year: new Date().getFullYear(), author })}
            <a href={repoUrl} class="underline decoration-1 underline-offset-[3px] hover:decoration-2">{t("footer.source")}</a>
          </p>
        </div>
        {
          [
            { heading: t("footer.sections"), items: navigation },
            { heading: t("footer.reference"), items: reference },
            { heading: t("footer.site"), items: footerPages },
          ]
            .filter((group) => group.items.length > 0)
            .map((group) => (
              <nav aria-label={group.heading}>
                <h2 class="text-xs font-bold uppercase tracking-[0.12em] opacity-70">{group.heading}</h2>
                <ul class="mt-3 space-y-2">
                  {group.items.map((item) => (
                    <li><a href={item.href} class="font-medium hover:underline hover:underline-offset-4">{item.text}</a></li>
                  ))}
                </ul>
              </nav>
            ))
        }
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  // Theme toggle. The choice is kept in localStorage (no cookies, see
  // CLAUDE.md); without a stored choice the system preference applies.
  {
    const darkModeToggle = document.getElementById("dark-mode-toggle");
    const sunIcon = document.querySelector(".sun-icon");
    const moonIcon = document.querySelector(".moon-icon");

    const showIcons = (isDark) => {
      sunIcon?.classList.toggle("hidden", isDark);
      moonIcon?.classList.toggle("hidden", !isDark);
      darkModeToggle?.setAttribute("aria-pressed", String(isDark));
    };

    showIcons(document.documentElement.classList.contains("dark"));

    darkModeToggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      showIcons(isDark);
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // Storage can be unavailable (private mode); the toggle still works.
      }
    });

    // Fade-up on scroll, for [data-reveal] blocks that start below the window.
    if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.dataset.reveal = "";
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -6% 0px" },
      );
      for (const el of document.querySelectorAll("[data-reveal]")) {
        if (el.getBoundingClientRect().top < innerHeight) continue;
        el.dataset.reveal = "waiting";
        observer.observe(el);
      }
    }

    // Menu: close it with Escape, on a click outside, or when a link in it
    // is followed (back/forward cache would otherwise show it open).
    const menu = document.querySelector("[data-site-menu]");
    if (menu) {
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (menu.open && !menu.contains(event.target)) menu.open = false;
      });
      addEventListener("pageshow", () => (menu.open = false));
    }
  }
</script>
