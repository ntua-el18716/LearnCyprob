---
import Link from "@components/Link.astro";
import { Icon } from "astro-icon/components";
import { author, defaultMeta, repoUrl } from "@data/constants";
import { localizePath, useTranslations } from "../lib/i18n";
import { getPageSlugs } from "../lib/pages";
import {
  defaultLocale,
  localeMeta,
  publishedLocales,
  type Locale,
} from "../i18n/locales";
import "@styles/global.css";
import "@fontsource-variable/commissioner";

interface Props {
  title?: string;
  description?: string;
  ogImage?: {
    src: string;
    alt: string;
  };
  pubDate?: Date;
  lang?: Locale;
  /** Keep the page out of search engines (drafts). */
  noindex?: boolean;
  /** This page in other languages; defaults to each language's home page. */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  lang = defaultLocale,
  noindex = false,
  pubDate,
  alternates = Object.fromEntries(
    publishedLocales.map((l) => [l, localizePath(l)]),
  ),
} = Astro.props;
const t = useTranslations(lang);
const {
  title = t("site.title"),
  description = t("site.description"),
  ogImage = defaultMeta.ogImage,
} = Astro.props;

const pageSlugs = await getPageSlugs();
const navigation = [
  { href: localizePath(lang), text: t("nav.home"), exact: true },
  { href: localizePath(lang, "explore"), text: t("nav.issues") },
  { href: localizePath(lang, "documents"), text: t("nav.documents") },
  { href: localizePath(lang, "compare"), text: t("nav.compare") },
  { href: localizePath(lang, "timeline"), text: t("nav.timeline") },
  { href: localizePath(lang, "glossary"), text: t("nav.glossary") },
];

// Footer: site pages that exist (about, methodology, corrections), in this order.
const footerPages = (["about", "methodology", "corrections"] as const).filter((slug) =>
  pageSlugs.includes(slug),
);

const ogImageURL = new URL(ogImage.src, Astro.site).href;
const canonicalURL = new URL(Astro.url).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Apply the theme before first paint to avoid a light flash.
      {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private mode); use the system preference.
        }
        const isDark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      }
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={author} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    {
      Object.entries(alternates).map(([l, href]) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(href, Astro.site).href}
        />
      ))
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "follow, index"} />
    <meta name="author" content={author} />
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-bg focus:px-4 focus:py-2 focus:text-ink focus:shadow"
      >{t("a11y.skipToContent")}</a
    >
    <header class="bg-accent text-on-accent dark:border-b dark:border-accent/40 dark:bg-panel dark:text-ink">
      <div class="mx-auto max-w-6xl px-4 sm:px-8">
        <div class="flex items-center gap-x-6 pt-3 md:py-3">
          <a href={localizePath(lang)} class="text-lg font-[760] tracking-tight whitespace-nowrap">
            {t("site.title")}
          </a>
          <nav aria-label={t("nav.label")} class="hidden md:block">
            <ul class="flex gap-x-5">
              {navigation.map((item) => <li><Link {...item} /></li>)}
            </ul>
          </nav>
          <div class="ml-auto flex items-center gap-3">
            <ul class="flex items-center gap-1 text-sm font-semibold" aria-label={t("nav.language")}>
              {
                publishedLocales.map((l) => (
                  <li>
                    <a
                      href={alternates[l] ?? localizePath(l)}
                      hreflang={l}
                      lang={l}
                      aria-current={l === lang ? "true" : undefined}
                      class:list={[
                        "block rounded px-2 py-1",
                        l === lang ? "bg-white/20 dark:bg-white/10" : "opacity-80 hover:opacity-100",
                      ]}
                    >
                      {localeMeta[l].short}<span class="sr-only"> {localeMeta[l].name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <button id="dark-mode-toggle" class="rounded p-1.5 hover:bg-white/20 dark:hover:bg-white/10" aria-label={t("theme.toggle")}>
              <Icon name="moon" class="w-5 h-5 sun-icon" />
              <Icon name="sun" class="w-5 h-5 moon-icon" />
            </button>
          </div>
        </div>
        <!-- Narrow screens: links on their own scrollable row. -->
        <nav aria-label={t("nav.label")} class="md:hidden -mx-4 overflow-x-auto px-4 pb-2 pt-1">
          <ul class="flex gap-x-5 whitespace-nowrap">
            {navigation.map((item) => <li><Link {...item} /></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-8 py-10 sm:py-14">
      <noscript>
        <p class="mb-8 rounded-md bg-sunken px-4 py-3 text-sm">{t("noscript.body")}</p>
      </noscript>
      <slot />
    </main>
    <footer class="border-t border-rule">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-8 text-sm text-muted flex flex-wrap items-baseline gap-x-8 gap-y-3">
        <span class="font-[760] text-ink">{t("site.title")}</span>
        {
          footerPages.length > 0 && (
            <ul class="flex flex-wrap gap-x-6">
              {footerPages.map((slug) => (
                <li>
                  <a href={localizePath(lang, slug)} class="link">{t(`footer.${slug}`)}</a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="sm:ml-auto">
          {t("footer.copyright", { year: new Date().getFullYear(), author })}
          <a href={repoUrl} class="link">{t("footer.source")}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  // Theme toggle. The choice is kept in localStorage (no cookies, see
  // CLAUDE.md); without a stored choice the system preference applies.
  {
    const darkModeToggle = document.getElementById("dark-mode-toggle");
    const sunIcon = document.querySelector(".sun-icon");
    const moonIcon = document.querySelector(".moon-icon");

    const showIcons = (isDark) => {
      sunIcon?.classList.toggle("hidden", isDark);
      moonIcon?.classList.toggle("hidden", !isDark);
      darkModeToggle?.setAttribute("aria-pressed", String(isDark));
    };

    showIcons(document.documentElement.classList.contains("dark"));

    darkModeToggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      showIcons(isDark);
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // Storage can be unavailable (private mode); the toggle still works.
      }
    });
  }
</script>
