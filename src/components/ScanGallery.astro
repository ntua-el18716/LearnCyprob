---
// Scanned pages of a document: optimised thumbnails, each linking to a larger
// optimised image. Static, no JavaScript.
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import { localeOf, useTranslations } from "../lib/i18n";

interface Props {
  scans: ImageMetadata[];
}

const { scans } = Astro.props;
const t = useTranslations(localeOf(Astro.currentLocale));
const pages = await Promise.all(
  scans.map(async (scan, i) => ({
    scan,
    n: i + 1,
    full: await getImage({ src: scan, width: Math.min(scan.width, 1600), format: "webp" }),
  })),
);
---

{
  pages.length > 0 && (
    <section aria-labelledby="scans" class="mt-12">
      <h2 id="scans" class="text-2xl font-[720]">
        {t("documents.scans")}
      </h2>
      <ol class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-6">
        {pages.map(({ scan, n, full }) => (
          <li>
            <a
              href={full.src}
              class="group relative block overflow-hidden rounded-lg border border-rule bg-sunken shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md motion-reduce:transition-none"
            >
              <Image
                src={scan}
                width={320}
                alt={t("documents.scanAlt", { n })}
                class="h-auto w-full"
              />
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
