---
// Nested list of issues; also the no-JS fallback for the issue explorer.
import type { IssueNode } from "../lib/issues";
import { localizePath } from "../lib/i18n";
import type { Locale } from "../i18n/locales";

interface Props {
  nodes: IssueNode[];
  lang: Locale;
}

const { nodes, lang } = Astro.props;
---

<ul class="list-disc pl-5 space-y-1">
  {
    nodes.map((node) => (
      <li>
        <a
          href={localizePath(lang, `issues/${node.slug}`)}
          lang={node.isFallback ? node.lang : undefined}
          class="link"
        >
          {node.title}
        </a>
        {node.children.length > 0 && <Astro.self nodes={node.children} lang={lang} />}
      </li>
    ))
  }
</ul>
