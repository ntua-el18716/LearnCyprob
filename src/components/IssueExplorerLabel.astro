---
// Title link plus status (glyph and text) for one explorer node.
import type { IssueNode } from "../lib/issues";
import { statusGlyphs } from "./content/status-glyphs";
import { localizePath, useTranslations } from "../lib/i18n";
import type { Locale } from "../i18n/locales";

interface Props {
  node: IssueNode;
  lang: Locale;
}

const { node, lang } = Astro.props;
const t = useTranslations(lang);
const statusKey = node.status && (`status.${node.status}` as const);
---

<span class="inline-flex flex-wrap items-baseline gap-x-2">
  <a
    href={localizePath(lang, `issues/${node.slug}`)}
    lang={node.isFallback ? node.lang : undefined}
    class="text-lg font-semibold link"
  >
    {node.title}
  </a>
  <span class="inline-flex items-center gap-1 text-sm text-muted">
    {node.status && <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" set:html={statusGlyphs[node.status]} />}
    {statusKey ? <span lang={t.langOf(statusKey)}>{t(statusKey)}</span> : <span>{t("explore.noStatus")}</span>}
  </span>
</span>
