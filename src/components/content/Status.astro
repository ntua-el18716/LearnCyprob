---
// <Status value="converged" sources={["source-id"]} />. A status always carries
// sources (CLAUDE.md). Each value has its own glyph shape plus a text label, so
// nothing depends on colour; the label links to its methodology definition.
import CitationMarks from "./CitationMarks.astro";
import { statusGlyphs, type StatusValue } from "./status-glyphs";
import { localeOf, localizePath, useTranslations } from "../../lib/i18n";

interface Props {
  value: StatusValue;
  sources: string[];
  numbers?: string;
  refs?: string;
  /** Large pill with a "Status in the talks" label (article header). */
  large?: boolean;
}

const { value, sources = [], numbers, refs, large = false } = Astro.props;
if (sources.length === 0) {
  throw new Error(`<Status value="${value}"> needs at least one source (CLAUDE.md: statuses must carry sources).`);
}

const lang = localeOf(Astro.currentLocale);
const t = useTranslations(lang);
const key = `status.${value}` as const;
const label = t(key);
const href = `${localizePath(lang, "methodology")}#status-${value}`;

---

<span
  class:list={[
    "status not-prose inline-flex items-center rounded-full font-sans text-ink",
    large ? "gap-3 border-2 border-ink py-2 pl-3.5 pr-5" : "gap-1.5 border border-control px-2.5 py-0.5 text-[0.9em] align-baseline",
  ]}
>
  <svg
    viewBox="0 0 12 12"
    width={large ? 20 : 12}
    height={large ? 20 : 12}
    aria-hidden="true"
    class="shrink-0"
    set:html={statusGlyphs[value]}
  />
  <span class:list={[large && "flex flex-col leading-tight"]}>
    {large ? (
      <span class="text-xs font-normal text-muted" lang={t.langOf("issue.status")}>{t("issue.status")}</span>
    ) : (
      <span class="sr-only">{t("status.label")}:</span>
    )}
    <span>
      <a
        href={href}
        title={t("status.definition", { status: label })}
        lang={t.langOf(key)}
        class:list={["no-underline hover:underline", large ? "font-[650]" : "font-medium"]}
      >
        {label}
      </a>
      {large && <CitationMarks ids={sources} numbers={numbers} refs={refs} />}
    </span>
  </span>
  {!large && <CitationMarks ids={sources} numbers={numbers} refs={refs} />}
</span>
