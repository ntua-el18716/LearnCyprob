---
// Methodology: <StatusTerm value="converged">definition…</StatusTerm>. Gives
// the #status-{value} anchor that every <Status> badge links to.
import { statusGlyphs, type StatusValue } from "./status-glyphs";
import { localeOf, useTranslations } from "../../lib/i18n";

interface Props {
  value: StatusValue;
}

const { value } = Astro.props;
const t = useTranslations(localeOf(Astro.currentLocale));
const key = `status.${value}` as const;
---

<section id={`status-${value}`} class="status-term not-prose my-8 scroll-mt-6 border-t border-rule pt-4 target:bg-panel target:px-4 target:rounded-lg">
  <h3 class="flex items-center gap-2 font-sans text-xl font-bold" lang={t.langOf(key)}>
    <svg viewBox="0 0 12 12" width="18" height="18" aria-hidden="true" set:html={statusGlyphs[value]} />
    {t(key)}
  </h3>
  <div class="prose prose-site max-w-none mt-1">
    <slot />
  </div>
</section>
