---
// The site's own argument or interpretation (PLAN.md §1): a tinted panel with
// its label, so the site's voice is never mistaken for fact.
import { localeOf, useTranslations } from "../../lib/i18n";

const t = useTranslations(localeOf(Astro.currentLocale));
---

<aside class="analysis not-prose my-8 rounded-2xl bg-panel px-5 py-4 sm:px-6 sm:py-5">
  <p class="font-sans text-sm">
    <span class="font-bold text-accent" lang={t.langOf("analysis.label")}>{t("analysis.label")}</span>
    <span class="text-muted" lang={t.langOf("analysis.note")}>{t("analysis.note")}</span>
  </p>
  <div class="prose prose-site max-w-none mt-2">
    <slot />
  </div>
</aside>
