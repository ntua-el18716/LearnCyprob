---
// Numbered sources for a page, generated from the `citations` frontmatter that
// remarkCitations writes. Never hand-written (CLAUDE.md).
import { getEntry } from "astro:content";
import type { Citation } from "../../lib/remark-citations";
import { localeOf, localizePath, useTranslations } from "../../lib/i18n";

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;
const lang = localeOf(Astro.currentLocale);
const t = useTranslations(lang);
const formatDate = new Intl.DateTimeFormat(lang, { dateStyle: "long" });
const letters = "abcdefghijklmnopqrstuvwxyz";

if (citations.length === 0) return null;

const entries = await Promise.all(
  citations.map(async ({ id, uses }, i) => {
    const source = await getEntry("sources", id);
    if (!source) throw new Error(`Unknown source "${id}" (no src/content/sources/${id}.yaml).`);
    const documentPath = source.data.document
      ? localizePath(lang, `documents/${source.data.document.id}`)
      : undefined;
    return { n: i + 1, uses, documentPath, ...source.data };
  }),
);
---

<section aria-labelledby="sources" class="mt-14 scroll-mt-6 border-t-2 border-rule pt-8">
  <h2 id="sources" class="text-2xl font-[720]">
    {t("sources.heading")}
  </h2>
  <ol class="mt-5 space-y-3 text-[0.95rem] leading-relaxed">
    {
      entries.map((s) => (
        <li id={`cite-src-${s.n}`} class="grid grid-cols-[3ch_1fr] gap-x-2 rounded-sm target:bg-panel">
          <span class="tabular-nums text-right font-semibold text-accent">{s.n}</span>
          <div>
            <span class="mr-1 whitespace-nowrap">
              {s.uses.map((use, i) => (
                <>
                  {i > 0 && " "}
                  <a
                    href={`#${use.ref}`}
                    aria-label={t("sources.backToText", { n: s.n })}
                    class="no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 rounded-sm"
                  >
                    {s.uses.length === 1 ? "↩" : letters[i]}
                  </a>
                </>
              ))}
            </span>
            {s.author && <span>{s.author}, </span>}
            {s.url || s.documentPath ? (
              <a href={s.url ?? s.documentPath} lang={s.lang} class="link">{s.title}</a>
            ) : (
              <span lang={s.lang}>{s.title}</span>
            )}{". "}
            {s.publisher}, <time datetime={s.date.toISOString().slice(0, 10)}>{formatDate.format(s.date)}</time>.
            {s.documentPath && s.url && (
              <> <a href={s.documentPath} class="link">{t("sources.inLibrary")}</a>.</>
            )}
            {s.archiveUrl && (
              <> <a href={s.archiveUrl} class="link">{t("sources.archived")}</a>.</>
            )}
            {s.documentPath &&
              s.uses
                .filter((use) => use.anchor)
                .map((use) => (
                  <>
                    {" "}
                    <a href={`${s.documentPath}#${use.anchor}`} class="link whitespace-nowrap">
                      ¶ {use.anchor!.replace(/-/g, " ")}
                    </a>
                  </>
                ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>
