---
// <Claim claim="…" sources={["source-id"]}>what the documents say</Claim>:
// sets a circulating claim against the documentary record.
import CitationMarks from "./CitationMarks.astro";
import { localeOf, useTranslations } from "../../lib/i18n";

interface Props {
  claim: string;
  sources: string[];
  numbers?: string;
  refs?: string;
}

const { claim, sources = [], numbers, refs } = Astro.props;
if (sources.length === 0) {
  throw new Error("<Claim> needs at least one source for what the documents say.");
}

const t = useTranslations(localeOf(Astro.currentLocale));
---

<dl
  class="claim not-prose my-8 grid gap-x-8 gap-y-3 border-y-2 border-rule py-5 sm:grid-cols-[minmax(9rem,auto)_1fr]"
>
  <dt class="font-sans text-sm font-bold text-muted" lang={t.langOf("claim.label")}>
    {t("claim.label")}
  </dt>
  <dd class="text-lg font-medium"><q>{claim}</q></dd>
  <dt class="font-sans text-sm font-bold text-muted">
    <span lang={t.langOf("claim.documents")}>{t("claim.documents")}</span><CitationMarks
      ids={sources}
      numbers={numbers}
      refs={refs}
    />
  </dt>
  <dd class="prose prose-site max-w-none">
    <slot />
  </dd>
</dl>
