---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  text: string;
  /** Only active on this exact path (e.g. a home page), not its children. */
  exact?: boolean;
}
const { text, href, exact = false, ...props } = Astro.props;
let isActive: boolean;
if (!href) {
  isActive = false;
} else if (exact) {
  isActive = href === Astro.url.pathname;
} else {
  isActive = Astro.url.pathname.includes(
    typeof href === "string" ? href : href.href,
  );
}
---

<a
  class:list={[
    "block py-1 font-medium",
    isActive
      ? "underline decoration-2 underline-offset-[6px]"
      : "opacity-85 hover:opacity-100 hover:underline hover:decoration-1 hover:underline-offset-[6px]",
  ]}
  aria-current={isActive ? "page" : undefined}
  href={href}
  {...props}
>
  {text}
</a>
