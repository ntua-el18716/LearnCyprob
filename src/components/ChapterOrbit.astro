---
// Home-page map: the chapters as circles around a centre, joined to it by
// lines. A list of links underneath; the lines and layout are decoration.
// Hovering or focusing a chapter shows its name in the centre.
import ChapterIcon from "./ChapterIcon.astro";
import type { IssueNode } from "../lib/issues";
import { localizePath, useTranslations } from "../lib/i18n";
import type { Locale } from "../i18n/locales";

interface Props {
  chapters: IssueNode[];
  lang: Locale;
}

const { chapters, lang } = Astro.props;
const t = useTranslations(lang);
const radius = 41; // % of the box, from the centre
const nodes = chapters.map((chapter, i) => {
  const angle = (i / chapters.length) * 2 * Math.PI - Math.PI / 2;
  return { chapter, x: 50 + radius * Math.cos(angle), y: 50 + radius * Math.sin(angle) };
});
const centre = t("home.mapCenter", { n: chapters.length });
---

<div class="chapter-orbit relative aspect-square w-full max-w-[30rem]" data-orbit>
  <svg viewBox="0 0 100 100" aria-hidden="true" class="absolute inset-0 h-full w-full text-rule">
    <circle cx="50" cy="50" r={radius} fill="none" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 1.5" />
    {nodes.map((n) => <line x1="50" y1="50" x2={n.x} y2={n.y} stroke="currentColor" stroke-width="0.4" data-line={n.chapter.slug} class="transition-colors" />)}
  </svg>

  <a
    href={localizePath(lang, "explore")}
    class="absolute left-1/2 top-1/2 grid size-[34%] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-accent p-3 text-center text-on-accent shadow-lg shadow-accent/20 transition hover:scale-[1.03]"
  >
    <span class="text-sm font-bold leading-tight sm:text-base" data-orbit-label data-default={centre}>{centre}</span>
  </a>

  <ul aria-label={t("home.mapHint")}>
    {
      nodes.map(({ chapter, x, y }) => (
        <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${x}%;top:${y}%`}>
          <a
            href={`${localizePath(lang, "explore")}#chapter-${chapter.slug}`}
            data-orbit-node={chapter.slug}
            data-title={chapter.title}
            class="group block rounded-full"
          >
            <ChapterIcon
              slug={chapter.slug}
              size="md"
              class="bg-bg ring-2 ring-rule transition duration-200 group-hover:scale-110 group-hover:bg-accent group-hover:text-on-accent group-hover:ring-accent group-focus-visible:bg-accent group-focus-visible:text-on-accent motion-reduce:transition-none"
            />
            <span class="sr-only" lang={chapter.isFallback ? chapter.lang : undefined}>{chapter.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Name the chapter under the pointer or focus in the centre circle, and
  // highlight its line.
  for (const orbit of document.querySelectorAll<HTMLElement>("[data-orbit]")) {
    const label = orbit.querySelector<HTMLElement>("[data-orbit-label]");
    if (!label) continue;
    const show = (node: HTMLElement | null) => {
      label.textContent = node?.dataset.title ?? label.dataset.default ?? "";
      orbit.querySelectorAll<SVGLineElement>("[data-line]").forEach((line) =>
        line.classList.toggle("text-accent", line.dataset.line === node?.dataset.orbitNode),
      );
    };
    orbit.querySelectorAll<HTMLElement>("[data-orbit-node]").forEach((node) => {
      node.addEventListener("pointerenter", () => show(node));
      node.addEventListener("focus", () => show(node));
      node.addEventListener("pointerleave", () => show(null));
      node.addEventListener("blur", () => show(null));
    });
  }
</script>
